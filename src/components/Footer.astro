---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { SITE } from '../data/site';
import { Mail } from 'lucide-react';

const profileLabels: Record<string, string> = {
  linkedin: 'LinkedIn', x: 'X', instagram: 'Instagram', youtube: 'YouTube', wikipedia: 'Wikipedia',
};
const profiles = Object.entries(SITE.profiles).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="bg-stone-900 text-stone-300 border-t border-stone-800 pt-16 pb-12 mt-20 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-stone-800">
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <Image src={avatar} alt="" width={76} height={76} class="w-[38px] h-[38px] object-cover border border-stone-700" />
          <div>
            <p class="font-serif text-base text-white tracking-wide">{SITE.name}</p>
            <p class="text-xs text-stone-400">{SITE.roleLine}</p>
          </div>
        </div>
        <p class="text-sm text-stone-400 leading-relaxed pr-4 font-serif max-w-md">
          Author of <em class="text-stone-200">Structural Marketing</em>, a 10-volume work built over eight years of research. She advises founders, family enterprises and leadership teams on marketing as one structure, from competition and pricing to channels and measurement.
        </p>
      </div>

      <div class="space-y-3">
        <p class="text-xs uppercase tracking-widest text-stone-200 font-semibold border-b border-stone-800 pb-2">Pages</p>
        <ul class="space-y-2 text-sm text-stone-400">
          <li><a href="/about/" class="hover:text-white">About</a></li>
          <li><a href="/works/" class="hover:text-white">Works</a></li>
          <li><a href="/structural-marketing/" class="hover:text-white">Structural Marketing (books)</a></li>
          <li><a href="/newsletter/" class="hover:text-white">Newsletter</a></li>
          <li><a href="/contact/" class="hover:text-white">Contact</a></li>
        </ul>
      </div>

      <div class="space-y-3">
        <p class="text-xs uppercase tracking-widest text-stone-200 font-semibold border-b border-stone-800 pb-2">Contact</p>
        <a href={`mailto:${SITE.email}`} class="text-xs text-stone-300 hover:underline break-all flex items-center gap-1.5">
          <Mail className="w-3.5 h-3.5 flex-shrink-0" /><span>{SITE.email}</span>
        </a>
        {profiles.length > 0 && (
          <ul class="space-y-2 text-sm text-stone-400 pt-2">
            {profiles.map(([key, url]) => (
              <li><a href={url} rel="me noopener" target="_blank" class="hover:text-white">{profileLabels[key] ?? key}</a></li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>© {year} {SITE.name}. {SITE.licence}</p>
      <div class="flex items-center gap-4">
        <a href="/privacy/" class="hover:text-white">Privacy</a>
        <span aria-hidden="true">•</span>
        <a href="/contact/" class="hover:text-white">Contact</a>
      </div>
    </div>
  </div>
</footer>
