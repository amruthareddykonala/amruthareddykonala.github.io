---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import certificate from '../assets/krajt-certificate.jpeg';
import conferral from '../assets/krajt-conferral.png';
import { SITE } from '../data/site';
import { Crown, GraduationCap, CheckCircle2 } from 'lucide-react';

const outcomes = [
  { org: 'Royal Family of Vogeti (Andhra Pradesh, India)', text: 'A legacy brand ecosystem built for an ancient royal family, producing an ₹8 crore lift in land value, ₹36 lakh per year in recurring commercial lease revenue, national magazine coverage, and formal recognition from the state government.' },
  { org: 'Kavalagoyya Estate (Andhra Pradesh, India)', text: 'Over ₹5 crore in accredited investor interest raised through a messaging-first demand plan without a single rupee of paid media.' },
  { org: 'State legislative and cabinet campaign', text: 'An organic, unpaid campaign architecture that carried a first-time candidate to a decisive legislative seat and a subsequent cabinet portfolio.' },
  { org: 'Royal House of Mangkualaman (Java, Indonesia)', text: "Creation and ongoing maintenance of the principality's digital presence, and international strategic counsel." },
];
---
<Base title="About" description={`About ${SITE.name}: strategic advisor, fractional CMO and author of Structural Marketing, the 10-volume work. NIT Jamshedpur engineer, Wikipedia historian and holder of the KRAjT noble title.`} ogType="profile">
  <div class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="border-b border-stone-200 pb-10 mb-12">
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight">About {SITE.name}</h1>
      <p class="font-serif text-xl sm:text-2xl text-stone-600 mt-3 max-w-3xl leading-relaxed italic">
        Strategic advisor, fractional CMO and author of <em class="not-italic text-[#1A1A1A]">Structural Marketing: The 10 Volumes</em>.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 space-y-12">
        <section class="space-y-4">
          <h2 class="font-serif text-2xl sm:text-3xl font-light flex items-center gap-2.5 pb-2 border-b border-stone-200"><span class="font-mono text-sm text-stone-400">01.</span> Profile</h2>
          <div class="font-serif text-lg sm:text-xl text-stone-700 leading-relaxed space-y-4">
            <p>
              {SITE.name} is a strategic advisor and the author of <strong class="text-[#1A1A1A] font-semibold">Structural Marketing: The 10 Volumes</strong> (2026), a 4,614-page treatment of marketing as an architectural engineering discipline rather than a promotional one.
            </p>
            <p>
              Her advisory work has spanned heritage and family enterprises, real estate developments, private principals and political campaigns. Structural market failures recur in the same shapes across very different industries, which is what makes a structural method portable.
            </p>
            <p>
              With the research and the books complete, she now also works as a <strong class="text-[#1A1A1A] font-semibold">fractional CMO</strong>: taking the whole marketing system of a growing company (competition, strategy, customer, value, pricing, channels, timing, execution and measurement) and running it as one structure, reported in the language of the P&amp;L.
            </p>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl sm:text-3xl font-light flex items-center gap-2.5 pb-2 border-b border-stone-200"><span class="font-mono text-sm text-stone-400">02.</span> Engineering training</h2>
          <div class="p-6 bg-white border border-stone-200 shadow-sm space-y-3">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 border border-stone-200 bg-stone-50 flex items-center justify-center"><GraduationCap className="w-5 h-5" /></span>
              <div>
                <h3 class="font-serif text-lg">National Institute of Technology (NIT), Jamshedpur</h3>
                <p class="text-xs text-stone-500">B.Tech in Electrical and Electronics Engineering (2020, 9-point academic record)</p>
              </div>
            </div>
            <p class="font-serif text-sm sm:text-base text-stone-600 leading-relaxed">
              Author of two IEEE published papers: one on speech-controlled robotics and one on solar-powered drip irrigation. The engineering training is not incidental to her advisory work: Structural Marketing treats a market position the way an electrical engineer treats a closed-loop system, as a network of loads, members, transfer functions and failure modes rather than an assortment of marketing messages.
            </p>
          </div>
        </section>

        <section id="honours" class="space-y-4 scroll-mt-28">
          <h2 class="font-serif text-2xl sm:text-3xl font-light flex items-center gap-2.5 pb-2 border-b border-stone-200"><span class="font-mono text-sm text-stone-400">03.</span> Honours</h2>
          <div class="p-8 bg-stone-50 border border-stone-200 shadow-sm space-y-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="space-y-1">
                <span class="inline-flex items-center gap-1.5 text-xs text-stone-500 font-semibold uppercase tracking-wider"><Crown className="w-4 h-4 text-[#8C7A6B]" />Noble court title</span>
                <h3 class="font-serif text-2xl sm:text-3xl font-light">Kanjeng Raden Ajeng Tumenggung (KRAjT)</h3>
                <p class="text-xs text-stone-500">Kingdom of Mangkualaman, Java, Indonesia • Conferred 24 July 2026</p>
              </div>
              <span class="font-mono text-xs px-2.5 py-1 bg-white border border-stone-200">Register 043/2026</span>
            </div>
            <div class="text-sm sm:text-base text-stone-700 leading-relaxed space-y-3 font-serif">
              <p>
                On 24 July 2026, His Majesty Kangjeng Gusti Pangeran Adipati Aria Mangku Alam II of the Kingdom of Mangkualaman conferred on her the permanent noble title <strong>Kanjeng Raden Ajeng Tumenggung (KRAjT)</strong>, entered on the court register under reference <em>043/SM/KRAjT/MA/GC/2026</em>.
              </p>
              <p>
                In Javanese court usage, <em>Tumenggung</em> is a senior rank, historically the level at which a court's affairs were administered. It was conferred on her as a foreign professional for strategic advisory work and for establishing the kingdom's global digital presence.
              </p>
            </div>
            <div class="pt-6 mt-2 border-t border-stone-200 grid grid-cols-1 md:grid-cols-2 gap-6">
              <figure class="space-y-2">
                <Image src={certificate} alt="Court register certificate conferring the title Kanjeng Raden Ajeng Tumenggung (KRAjT), dated 24 July 2026" widths={[480, 960]} sizes="(min-width: 768px) 380px, 100vw" class="w-full h-auto border border-stone-300 shadow-sm" />
                <figcaption class="text-[10px] text-stone-500 uppercase tracking-widest text-center">Court register certificate</figcaption>
              </figure>
              <figure class="space-y-2">
                <Image src={conferral} alt={`${SITE.name} holding the framed KRAjT certificate`} widths={[480, 960]} sizes="(min-width: 768px) 380px, 100vw" class="w-full h-auto border border-stone-300 shadow-sm" />
                <figcaption class="text-[10px] text-stone-500 uppercase tracking-widest text-center">With the certificate</figcaption>
              </figure>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl sm:text-3xl font-light flex items-center gap-2.5 pb-2 border-b border-stone-200"><span class="font-mono text-sm text-stone-400">04.</span> Selected outcomes</h2>
          <ul class="space-y-4 text-sm text-stone-700 font-serif">
            {outcomes.map((o) => (
              <li class="p-5 bg-white border border-stone-200 shadow-sm flex items-start gap-3">
                <CheckCircle2 className="w-5 h-5 mt-0.5 flex-shrink-0" />
                <div><strong class="block text-base font-medium font-sans">{o.org}</strong><span class="text-stone-600">{o.text}</span></div>
              </li>
            ))}
          </ul>
          <a href="/works/" class="inline-block text-xs font-semibold uppercase tracking-widest border-b border-stone-400 hover:border-black pb-1">All previous work</a>
        </section>

        <section class="space-y-4">
          <h2 class="font-serif text-2xl sm:text-3xl font-light flex items-center gap-2.5 pb-2 border-b border-stone-200"><span class="font-mono text-sm text-stone-400">05.</span> Wikipedia and the historical record</h2>
          <div class="p-6 bg-white border border-stone-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="space-y-1">
              <span class="text-xs text-stone-400 uppercase tracking-widest block font-semibold">Top 3,300 worldwide</span>
              <h3 class="font-serif text-2xl">259 articles created • 2,500+ edits</h3>
              <p class="font-serif text-sm text-stone-600 max-w-xl">Restoring unrecorded Telugu history, colonial-era hill kingdom rebellions, forgotten royal lineages and South Indian archival figures to the public record.</p>
            </div>
            <div class="px-5 py-4 bg-stone-50 border border-stone-200 text-center flex-shrink-0">
              <span class="text-2xl font-serif font-light block">259</span>
              <span class="text-[10px] uppercase tracking-wider text-stone-500">Articles</span>
            </div>
          </div>
        </section>
      </div>

      <aside class="lg:col-span-4">
        <div class="lg:sticky top-28 p-7 bg-white border border-stone-200 space-y-6 shadow-sm">
          <div class="border-b border-stone-200 pb-5 flex items-center gap-4">
            <Image src={avatar} alt="Illustrated portrait of Amrutha Reddy Konala" width={112} height={112} class="w-14 h-14 object-cover border border-stone-800" />
            <div>
              <span class="text-[10px] uppercase tracking-[0.25em] text-stone-400 font-semibold block mb-0.5">Factsheet</span>
              <p class="font-serif text-xl">{SITE.name}</p>
            </div>
          </div>
          <dl class="space-y-4 text-xs text-stone-600">
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Practice</dt><dd class="font-medium text-stone-900 mt-0.5">Strategic Advisor, Fractional CMO, Author</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Books</dt><dd class="font-medium text-stone-900 mt-0.5">Structural Marketing: The 10 Volumes (4,614 pages)</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Education</dt><dd class="font-medium text-stone-900 mt-0.5">B.Tech EEE, NIT Jamshedpur (2020); two IEEE papers</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Honour</dt><dd class="font-medium text-stone-900 mt-0.5">KRAjT, Kingdom of Mangkualaman (2026)</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Disciplines</dt><dd class="font-medium text-stone-900 mt-0.5">Narrative, design systems, 2D/3D animation, software, archival research</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Works with</dt><dd class="font-medium text-stone-900 mt-0.5">India and worldwide</dd></div>
            <div><dt class="text-stone-400 uppercase text-[10px] tracking-wider font-semibold">Email</dt><dd class="font-mono text-stone-800 mt-0.5 break-all"><a href={`mailto:${SITE.email}`} class="hover:underline">{SITE.email}</a></dd></div>
          </dl>
          <div class="pt-4 border-t border-stone-200 space-y-2.5">
            <a href="/works/" class="w-full py-3 px-3 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800 text-center block">Previous work</a>
            <a href="/contact/" class="w-full py-3 px-3 text-xs font-semibold uppercase tracking-widest text-stone-800 bg-white border border-stone-300 hover:border-black text-center block">Work with me</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>
