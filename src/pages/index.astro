---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import heroBanner from '../assets/hero-banner.png';
import { SITE, PILLARS } from '../data/site';
import { BOOKS_DATA } from '../data/books';
import Disciplines from '../components/Disciplines.astro';
import { ArrowRight, BookOpen, Sparkles } from 'lucide-react';

const metrics = [
  { org: 'Royal Family of Vogeti', value: '+₹8 Crore', text: 'Lift in realised land value, plus ₹36 lakh a year in new recurring lease revenue.' },
  { org: 'Kavalagoyya Estate', value: '₹5+ Crore', text: 'Accredited investor interest raised through a messaging-first demand plan, with no paid ads.' },
  { org: 'Kingdom of Mangkualaman', value: 'KRAjT', text: 'Permanent noble title conferred by His Majesty KGPAA Mangku Alam II for strategic advisory work, July 2026.', href: '/about/#honours' },
  { org: 'Historical record', value: 'Top 3,300', text: 'Wikipedia contributor worldwide: 259 articles and 2,500+ edits on archival history.' },
];
---
<Base title={SITE.name}>
  <section class="relative overflow-hidden pt-6 pb-20 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <Image src={heroBanner} alt={`Illustration of ${SITE.name} at her desk with a book, film reel, laptop and globe, shaking hands with a client`} widths={[800, 1400, 2000]} sizes="(min-width: 1280px) 1216px, 100vw" class="w-full h-auto border border-stone-200" loading="eager" fetchpriority="high" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <p class="font-sans text-[11px] uppercase tracking-[0.3em] text-stone-500 font-semibold">{SITE.roleLine}</p>
            <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light tracking-tight leading-[1.08]">
              Marketing, built as a <span class="italic">structure</span>, not a campaign.
            </h1>
          </div>
          <p class="font-serif text-xl sm:text-2xl text-stone-700 leading-relaxed max-w-2xl font-light italic">
            "Strategy that cannot be built is merely a recommendation."
          </p>
          <p class="text-sm sm:text-base text-stone-600 leading-relaxed max-w-2xl">
            {SITE.name} works with founders, family enterprises and leadership teams as a strategic advisor and fractional CMO. Her method is <strong class="text-[#1A1A1A] font-semibold">Structural Marketing</strong>, a 10-volume body of work written over eight years: nine questions, from competition to measurement, answered as one system and priced in the language of the P&amp;L.
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-4 font-sans">
            <a href="/contact/" class="px-6 py-3.5 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800 transition-all flex items-center gap-2 shadow-sm">
              <span>Work with me</span><ArrowRight className="w-4 h-4" />
            </a>
            <a href="/structural-marketing/" class="px-6 py-3.5 text-xs font-semibold uppercase tracking-widest text-stone-800 bg-white border border-stone-300 hover:border-black transition-all flex items-center gap-2 shadow-sm">
              <BookOpen className="w-4 h-4" /><span>The 10 volumes</span>
            </a>
            <a href="/about/" class="px-4 py-3.5 text-xs text-stone-600 hover:text-black flex items-center gap-1.5 font-medium">
              <span>Read biography</span><ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="p-8 bg-white border border-stone-200 shadow-sm">
            <div class="flex items-center justify-between border-b border-stone-200 pb-4 mb-6">
              <span class="text-xs font-bold uppercase tracking-wider text-stone-900 flex items-center gap-2"><Sparkles className="w-4 h-4 text-[#8C7A6B]" />The nine questions</span>
              <span class="text-[11px] font-mono px-2.5 py-1 bg-stone-100 border border-stone-200">Structural Marketing</span>
            </div>
            <ol class="space-y-2.5 text-sm">
              {PILLARS.map((p, i) => (
                <li class="flex items-baseline gap-3">
                  <span class="font-mono text-[11px] text-stone-400 w-5">{String(i + 1).padStart(2, '0')}</span>
                  <span><strong class="font-semibold tracking-wide text-xs">{p.name}</strong> <span class="font-serif text-stone-600">{p.q}</span></span>
                </li>
              ))}
            </ol>
            <a href="/structural-marketing/" class="mt-6 w-full py-3 px-4 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800 transition-all flex items-center justify-center gap-2">
              <span>How the system works</span><ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-16 pt-10 border-t border-stone-200">
        {metrics.map((m) => (
          <a href={m.href ?? '/works/'} class="p-6 bg-white border border-stone-200 hover:border-black transition-all group shadow-sm block">
            <span class="text-[10px] font-semibold text-stone-400 uppercase tracking-widest block mb-1">{m.org}</span>
            <span class="font-serif text-3xl font-light group-hover:underline underline-offset-4 block">{m.value}</span>
            <span class="text-xs text-stone-600 mt-2 leading-relaxed font-serif block">{m.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Disciplines />

  <section class="py-20 border-b border-stone-200 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <p class="inline-flex items-center gap-2 text-[10px] text-stone-500 uppercase tracking-[0.3em]"><Sparkles className="w-3.5 h-3.5 text-[#8C7A6B]" />Eight years of research</p>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-light tracking-tight leading-tight">
          Structural Marketing: <br /><span class="italic">The 10 Volumes</span>
        </h2>
        <p class="font-serif text-base sm:text-lg text-stone-600 leading-relaxed">
          A 4,614-page, 1.74-million-word work in ten volumes (COMPETE, WHY, WHO, WHAT, HOW MUCH, WHERE, WHEN, HOW, SO WHAT and THE SYSTEMS) that treats marketing as an engineering discipline of loads, failure modes and defensible moats.
        </p>
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="/structural-marketing/" class="px-6 py-3 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800 flex items-center gap-2">
            <span>Explore the 10 volumes</span><ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="p-8 bg-white border border-stone-200 shadow-sm">
          <p class="text-[11px] font-bold text-stone-800 uppercase tracking-widest border-b border-stone-200 pb-4 mb-6">The ten volumes</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            {BOOKS_DATA.map((b, i) => (
              <li>
                <a href={`/books/${b.id}/`} class="p-3 bg-stone-50 border border-stone-200 hover:border-black flex items-center gap-2.5 text-stone-700">
                  <span class="text-stone-400 font-mono font-bold text-[11px]">{String(i + 1).padStart(2, '0')}</span>
                  <span class="truncate font-serif italic">{b.title.replace('Structural Marketing: ', '')}: {b.subtitle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>


  <section class="py-24 bg-stone-50 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight">
        Start with one <span class="italic">conversation</span>.
      </h2>
      <p class="font-serif text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mx-auto">
        Strategic advisory and fractional CMO work for founders, family enterprises, real estate and heritage holdings, and growing companies, in India and worldwide.
      </p>
      <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact/" class="px-8 py-4 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800 shadow-md">Send an enquiry</a>
        <a href="/works/" class="px-6 py-4 text-xs font-semibold uppercase tracking-widest text-stone-800 bg-white border border-black hover:bg-stone-100">See previous work</a>
      </div>
    </div>
  </section>
</Base>
