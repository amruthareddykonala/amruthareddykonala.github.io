---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Newsletter" description={`The ${SITE.name} newsletter: one essay every two weeks on marketing as a structure, with a chart and three links.`}>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto space-y-6">
    <p class="text-xs uppercase tracking-widest text-stone-500">Newsletter</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-light tracking-tight">One essay every two weeks</h1>
    <p class="font-serif text-xl text-stone-600 leading-relaxed">Marketing as one structure: competition, strategy, customer, value, pricing, channels, timing, execution and measurement. Each issue has one essay, one chart and three links worth your time. Free.</p>
    {SITE.newsletterFormUrl ? (
      <a href={SITE.newsletterFormUrl} class="inline-block px-8 py-4 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800">Subscribe</a>
    ) : (
      <div class="p-6 bg-stone-50 border border-stone-200 space-y-2">
        <p class="font-serif text-lg">Launching soon.</p>
        <p class="text-sm text-stone-600">To hear when the first issue goes out, email <a href={`mailto:${SITE.email}?subject=Newsletter`} class="underline">{SITE.email}</a> with the subject "Newsletter".</p>
      </div>
    )}
  </div>
</Base>
