---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Your message has been sent.">
  <div class="py-24 px-4 max-w-2xl mx-auto text-center space-y-6">
    <h1 class="font-serif text-4xl sm:text-5xl font-light">Thank you. Your message has been sent.</h1>
    <p class="font-serif text-lg text-stone-600">It will be read personally, and you will get a reply by email, usually within two working days.</p>
    <a href="/" class="inline-block px-6 py-3 text-xs font-semibold uppercase tracking-widest text-white bg-black hover:bg-stone-800">Back to home</a>
  </div>
</Base>
